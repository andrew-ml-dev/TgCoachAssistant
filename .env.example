# Токен от @BotFather
BOT_TOKEN=
# Ваш Telegram ID (узнать: написать @userinfobot). Если пусто — владельцем станет первый, кто отправит /start
ALLOWED_USER_ID=
# Ключ Anthropic API (console.anthropic.com)
ANTHROPIC_API_KEY=
# Модель и цена за 1M токенов (для счётчика /cost)
MODEL=claude-haiku-5-5
PRICE_IN=0.10
PRICE_OUT=0.50
# Месячный лимит расходов на API, USD
MONTHLY_LLM_BUDGET=2.0
TZ_NAME=Europe/Warsaw
